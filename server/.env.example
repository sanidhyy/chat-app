# HTTP port the Express server listens on.
PORT=5000

# MongoDB connection string.
MONGO_URL=mongodb://127.0.0.1:27017/snappy

# Algorithm passed to Node's crypto.createCipheriv / createDecipheriv.
MESSAGE_ALGORITHM=aes-256-ctr

# 32-byte secret required by aes-256-ctr (32 ASCII characters, or 32 hex chars from `openssl rand -hex 16`).
MESSAGE_SECRET_KEY=

# Origin of the Vite client. Used as the Socket.IO CORS allowlist.
CLIENT_URL=http://localhost:3000
