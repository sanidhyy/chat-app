# HTTP port the Express server listens on.
PORT=5000

# MongoDB connection string.
# Local: mongodb://127.0.0.1:27017/snappy
# Atlas: Cloud > Connect > Drivers. Use a database user password, not your Atlas login.
# Docs: https://www.mongodb.com/docs/manual/reference/connection-string/
MONGO_URL=mongodb://127.0.0.1:27017/snappy

# Algorithm passed to Node's crypto.createCipheriv / createDecipheriv.
# Must stay in sync with messages already stored in the database.
MESSAGE_ALGORITHM=aes-256-ctr

# 32-byte secret required by aes-256-ctr (32 ASCII characters, or 32 hex chars from `openssl rand -hex 16`).
# Generate a new value with: openssl rand -hex 16
# Changing this value makes existing encrypted messages unreadable.
MESSAGE_SECRET_KEY=

# Origin of the Vite client. Used as the Socket.IO CORS allowlist.
# Dev default is http://localhost:3000 (see public/vite.config.ts).
CLIENT_URL=http://localhost:3000
